# ==============================================================================
# Smart CRM & Lead Management System - Environment Variables Template
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Application Port
PORT=8080

# Database Configuration (MySQL 8+ / MariaDB 10.4+)
DB_URL=jdbc:mysql://localhost:3306/smart_crm?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=crm_user
DB_PASSWORD=crm_password_here

# JWT Authentication Security (Minimum 32 characters for HMAC-SHA256)
JWT_SECRET=replace_this_with_a_secure_random_key_of_at_least_32_characters!
JWT_EXPIRATION_MS=86400000

# Default Initial Administrator Account
ADMIN_EMAIL=admin@smartcrm.com
ADMIN_PASSWORD=Admin@123CRM!
ADMIN_NAME=System Administrator

# Google Gemini AI Provider Configuration (Optional)
# If omitted or invalid, the system automatically uses deterministic heuristics
# and displays graceful configuration notices without crashing.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=10000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
